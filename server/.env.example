# Required. Random string, at least 32 chars. The server refuses to start with the placeholder.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-in-production

# Summarize feature. "fake" needs no key and runs offline (default). "anthropic" needs a key.
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-haiku-4-5.
# ANTHROPIC_MODEL=claude-haiku-4-5

PORT=4000
